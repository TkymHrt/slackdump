#!/usr/bin/python3
"""Publish checked SQLite snapshots with bounded operations and durable rollback."""
import contextlib
import logging
import os
from pathlib import Path
import shutil
import signal
import sqlite3
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

LOG = logging.getLogger('viewer-refresh')
OPERATION_TIMEOUT = 300
VIEWER = 'slack-dump-view.service'
MCP = 'slack-dump-mcp.service'


def unit(action, name, *args):
    return subprocess.run(['systemctl', action, *args, name], check=True,
                          capture_output=True, text=True, timeout=120).stdout.strip()


@contextlib.contextmanager
def stage(name):
    started = time.monotonic()
    LOG.info('stage=%s started', name)
    try:
        yield
    except BaseException:
        LOG.exception('stage=%s failed elapsed=%.1fs', name, time.monotonic()-started)
        raise
    LOG.info('stage=%s completed elapsed=%.1fs', name, time.monotonic()-started)


@contextlib.contextmanager
def database(path, readonly=False):
    # Never silently create a missing input database.
    mode = 'ro' if readonly else 'rw'
    conn = sqlite3.connect(path.resolve().as_uri()+'?mode='+mode, uri=True, timeout=5)
    deadline = time.monotonic()+OPERATION_TIMEOUT
    conn.set_progress_handler(lambda: int(time.monotonic() >= deadline), 10000)
    try:
        yield conn
    finally:
        conn.close()


def sync_directory(path):
    if os.name != 'nt':
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)


def mark(path, message):
    with path.open('w') as marker:
        marker.write(message+'\n')
        marker.flush()
        os.fsync(marker.fileno())
    sync_directory(path.parent)


def normalize(path):
    """Require a self-contained database before filesystem replacement."""
    with database(path) as conn:
        checkpoint = conn.execute('PRAGMA wal_checkpoint(TRUNCATE)').fetchone()
        if checkpoint[0] != 0:
            raise RuntimeError(f'checkpoint busy: {path}: {checkpoint}')
        mode = conn.execute('PRAGMA journal_mode=DELETE').fetchone()[0]
        if mode != 'delete':
            raise RuntimeError(f'cannot leave WAL mode: {path}: {mode}')
    with path.open('r+b') as stream:
        os.fsync(stream.fileno())


def copy_connection(src, dst, source):
    deadline = time.monotonic()+OPERATION_TIMEOUT
    last_report = time.monotonic()
    def progress(status, remaining, total):
        nonlocal last_report
        now = time.monotonic()
        if now >= deadline:
            raise TimeoutError(f'backup exceeded {OPERATION_TIMEOUT}s: {source}')
        if now-last_report >= 10:
            LOG.info('backup=%s remaining=%s total=%s sqlite_status=%s', source, remaining, total, status)
            last_report = now
    src.backup(dst, pages=256, progress=progress, sleep=0.1)


def backup(source, target):
    with database(source, readonly=True) as src:
        dst = sqlite3.connect(target, timeout=5)
        try:
            copy_connection(src, dst, source)
        finally:
            dst.close()
    normalize(target)


def require_memory(path):
    # Allow space for the working SQLite DB, index/sort buffers and file cache.
    meminfo = Path('/proc/meminfo')
    required = path.stat().st_size*2 + 128*1024*1024
    if meminfo.exists():
        total = int(next(line.split()[1] for line in meminfo.read_text().splitlines()
                         if line.startswith('MemTotal:')))*1024
        if total < required:
            raise MemoryError(f'snapshot requires at least {required} bytes RAM; configured={total}')


def prepare_index(path):
    require_memory(path)
    indexed = path.with_name('indexed.sqlite')
    memory = sqlite3.connect(':memory:')
    try:
        with stage('index-memory-load'):
            with database(path, readonly=True) as src:
                copy_connection(src, memory, path)
        with stage('index-memory-build'):
            deadline = time.monotonic()+OPERATION_TIMEOUT
            memory.set_progress_handler(lambda: int(time.monotonic() >= deadline), 10000)
            memory.execute('PRAGMA temp_store=MEMORY')
            memory.execute('CREATE INDEX IF NOT EXISTS MESSAGE_VIEWER_PAGE ON MESSAGE (CHANNEL_ID, ID DESC, CHUNK_ID DESC)')
            memory.commit()
            if memory.execute('PRAGMA quick_check').fetchall() != [('ok',)]:
                raise RuntimeError('indexed snapshot failed quick_check')
        with stage('index-memory-save'):
            dst = sqlite3.connect(indexed)
            try:
                copy_connection(memory, dst, path)
            finally:
                dst.close()
    finally:
        memory.close()
    normalize(indexed)
    os.replace(indexed, path)


def check(path):
    # Cold random reads were slower than the old 20-minute deadline. Loading
    # into SQLite memory uses sequential backup reads and bounds RAM first.
    require_memory(path)
    memory = sqlite3.connect(':memory:')
    try:
        with stage('check-memory-load'):
            with database(path, readonly=True) as src:
                copy_connection(src, memory, path)
        with stage('check-memory-verify'):
            deadline = time.monotonic()+OPERATION_TIMEOUT
            memory.set_progress_handler(lambda: int(time.monotonic() >= deadline), 10000)
            result = memory.execute('PRAGMA quick_check').fetchall()
            if result != [('ok',)]:
                raise RuntimeError(f'quick_check failed: {path}: {result[:5]}')
    finally:
        memory.close()


def preserve_aliases(previous, next_path):
    with database(previous, readonly=True) as old:
        exists = old.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='ALIAS'").fetchone()
        aliases = old.execute('SELECT CHANNEL_ID, ALIAS, CREATED_AT FROM ALIAS').fetchall() if exists else []
    with database(next_path) as new:
        new.execute('CREATE TABLE IF NOT EXISTS ALIAS (CHANNEL_ID TEXT NOT NULL PRIMARY KEY, ALIAS TEXT, CREATED_AT TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP)')
        # Preserve deletions too: the viewer is authoritative for aliases.
        new.execute('DELETE FROM ALIAS')
        new.executemany('INSERT INTO ALIAS (CHANNEL_ID, ALIAS, CREATED_AT) VALUES (?, ?, ?)', aliases)
        new.commit()
    LOG.info('preserved_aliases=%s', len(aliases))


def healthy(timeout=300):
    deadline = time.monotonic()+timeout
    while time.monotonic() < deadline:
        remaining = deadline-time.monotonic()
        if remaining <= 0:
            break
        try:
            with urllib.request.urlopen('http://127.0.0.1:8080/api/bootstrap', timeout=min(2, remaining)) as response:
                if response.status == 200:
                    return
        except (OSError, urllib.error.URLError):
            pass
        time.sleep(min(1, max(0, deadline-time.monotonic())))
    raise TimeoutError(f'viewer did not become healthy within {timeout}s')


class Refresh:
    def __init__(self, root):
        self.live = root/'archive/slackdump.sqlite'
        self.view = root/'viewer-archive/slackdump.sqlite'
        self.rollback = self.view.with_name('slackdump.sqlite.rollback')
        self.pending = self.view.with_name('refresh-pending')
        self.mcp_pending = self.view.with_name('mcp-restart-pending')
        self.viewer_pending = self.view.with_name('viewer-restart-pending')

    def restore_mcp(self):
        if self.mcp_pending.exists():
            unit('start', MCP)
            self.mcp_pending.unlink()
            sync_directory(self.view.parent)

    def permissions(self, path):
        shutil.chown(path, user='slack-dump', group='slack-dump')
        path.chmod(0o600)

    def recover(self):
        if not self.pending.exists():
            if self.viewer_pending.exists():
                unit('start', VIEWER)
                healthy()
                self.viewer_pending.unlink()
                sync_directory(self.view.parent)
            return
        with stage('rollback'):
            unit('stop', VIEWER)
            # Keep the recovery source intact if interrupted again.
            with tempfile.TemporaryDirectory(prefix='.recover-', dir=self.view.parent) as directory:
                restored = Path(directory)/'restored.sqlite'
                backup(self.rollback, restored)
                check(restored)
                self.permissions(restored)
                normalize(self.view)
                os.replace(restored, self.view)
                sync_directory(self.view.parent)
            unit('start', VIEWER)
            healthy()
            self.pending.unlink()
            self.viewer_pending.unlink(missing_ok=True)
            sync_directory(self.view.parent)

    def run(self):
        self.recover()
        self.restore_mcp()
        if (unit('show', 'slack-dump-resume.service', '-P', 'ActiveState') != 'inactive'
                or unit('show', 'slack-dump-resume.service', '-P', 'Result') != 'success'):
            raise RuntimeError('archive job has not finished successfully')
        mcp_active = unit('show', MCP, '-P', 'ActiveState') == 'active'
        viewer_stopped = False
        try:
            with tempfile.TemporaryDirectory(prefix='.refresh-', dir=self.view.parent) as directory:
                next_path, old_path = Path(directory)/'next.sqlite', Path(directory)/'old.sqlite'
                with stage('archive-backup'):
                    # MCP opens/migrates this DB. Quiesce it before the backup.
                    if mcp_active:
                        mark(self.mcp_pending, 'MCP was active before refresh')
                        unit('stop', MCP)
                    backup(self.live, next_path)
                with stage('prepare-index'):
                    prepare_index(next_path)
                with stage('preserve-viewer'):
                    viewer_stopped = True
                    mark(self.viewer_pending, 'restart old viewer if interrupted before publish')
                    unit('stop', VIEWER)
                    backup(self.view, old_path)
                    check(old_path)
                    preserve_aliases(old_path, next_path)
                    normalize(next_path)
                    check(next_path)
                    self.permissions(next_path)
                    self.permissions(old_path)
                    # Release WAL before replacing its associated main file.
                    normalize(self.view)
                with stage('publish'):
                    os.replace(old_path, self.rollback)
                    sync_directory(self.view.parent)
                    mark(self.pending, 'rollback required until health check succeeds')
                    os.replace(next_path, self.view)
                    sync_directory(self.view.parent)
                    unit('start', VIEWER)
                    healthy()
                    self.pending.unlink()
                    self.viewer_pending.unlink()
                    sync_directory(self.view.parent)
                    viewer_stopped = False
            LOG.info('viewer snapshot refreshed')
        except BaseException:
            if self.pending.exists():
                self.recover()
            elif viewer_stopped:
                self.recover()
            raise
        finally:
            if mcp_active:
                try:
                    self.restore_mcp()
                except Exception:
                    LOG.exception('MCP restart failed; viewer refresh result is unchanged')


def main():
    import fcntl
    logging.basicConfig(level=logging.INFO, format='%(asctime)s %(levelname)s %(message)s')
    os.umask(0o077)
    refresh = Refresh(Path('/srv/slack-dump'))
    with open('/run/slack-dump-archive.lock', 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        def interrupted(signum, frame):
            raise InterruptedError(f'received signal {signum}')
        signal.signal(signal.SIGTERM, interrupted)
        if sys.argv[1:] == ['--recover']:
            refresh.recover()
            refresh.restore_mcp()
        elif not sys.argv[1:]:
            refresh.run()
        else:
            raise ValueError('usage: slack-dump-view-refresh [--recover]')


if __name__ == '__main__':
    main()
