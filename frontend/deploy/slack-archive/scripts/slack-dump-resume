#!/bin/bash
set -euo pipefail

flock -n /run/slack-dump-archive.lock runuser -u slack-dump -- \
  env HOME=/var/lib/slack-dump \
  /usr/bin/slackdump resume \
    -chan-types public_channel \
    -refresh \
    -threads \
    -dedupe \
    /srv/slack-dump/archive

# Viewer snapshots are refreshed by slack-dump-view-refresh.service via OnSuccess.
# The refresh service restarts MCP after copying the archive. Restarting MCP
# here races its database migrations against the OnSuccess snapshot backup.
